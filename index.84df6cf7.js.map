"use strict";
function getSalary(salary) {
    return +salary.replace(/[^0-9]/g, "");
}
function sortList(list) {
    var items = Array.from(list.querySelectorAll("li"));
    var itemsSorted = items.sort(function(a, b) {
        var salaryA = getSalary(a.dataset.salary);
        var salaryB = getSalary(b.dataset.salary);
        return salaryB - salaryA;
    });
    list.innerHTML = "";
    itemsSorted.forEach(function(item) {
        return list.appendChild(item);
    });
}
function getEmployees(list) {
    var employees = Array.from(list.querySelectorAll("li"));
    return employees.map(function(el) {
        var names = el.textContent.trim();
        var salary = getSalary(el.getAttribute("data-salary"));
        return {
            names: names,
            salary: salary
        };
    });
}
var employeesList = document.querySelector("ul");
sortList(employeesList);
getEmployees(employeesList);

